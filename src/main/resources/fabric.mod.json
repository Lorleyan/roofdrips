{
  "schemaVersion": 1,
  "id": "livingrain",
  "version": "${version}",
  "name": "Living Rain",
  "description": "Particle-based rain and snow that changes from storm to storm and during storms, with simulated wind. Configure via Mod Menu.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": ["com.example.livingrain.LivingRainMod"],
    "client": ["com.example.livingrain.LivingRainClient"],
    "modmenu": ["com.example.livingrain.LivingRainModMenu"],
    "roofdrips:wind": ["com.example.livingrain.RoofDripsWindSupplier"]
  },
  "mixins": [
    "livingrain.mixins.json",
    "livingrain.weather.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "yet_another_config_lib_v3": "*",
    "roofdrips": "*"
  }
}
